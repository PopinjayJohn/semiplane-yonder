package templates

import (
	"strings"
	"time"
	"github.com/semiplane/yonder/internal/auth"
	"github.com/semiplane/yonder/internal/markdown"
)

// PageData is the server-filtered view model for a page render. BodyHTML,
// TOC, Links, and Nav have already passed secrets.Filter per-viewer;
// templates must never re-introduce hidden content (no client-side hiding,
// no raw page fields).
type PageData struct {
	Title         string
	Path          string
	BodyHTML      string
	TOC           []markdown.TOCEntry
	Backlinks     []Backlink
	Nav           []NavEntry
	Secret        bool
	Owner         string
	Quarantined   bool
	Quarantine    string
	ViewerLabel   string
	PreviewAs     string
	AsParam       string
	Slots         []SlotMark
	CSRFToken     string // double-submit CSRF token for state-changing forms
	CampaignName  string // campaign name from campaign.yaml
	LandingPage   string // landing page from campaign.yaml (default "welcome")
}

type Backlink struct {
	Path  string
	Title string
}

type NavEntry struct {
	Path   string
	Title  string
	Secret bool
	Active bool
}

type SearchHit struct {
	Path    string
	Title   string
	Snippet string
	Secret  bool
}

// SlotMark is one enabled plugin slot mount point for the shell. Marks come
// from the enabled-aware provider (plugins.Registry.SlotsFor via web
// SlotProvider) — never the raw registry — so a disabled plugin leaves no
// UI trace, not even a mount point. Components render client-side from the
// plugin fragment contract (Lane K display); the shell only mounts.
type SlotMark struct {
	SlotName  string // frozen slot name (header-right, sidebar-left, ...)
	ID        string // component id within the slot
	Component string // plugin component name (mount key)
	PluginID  string // owning plugin (CSS namespace)
}

func viewerName(v *auth.Viewer) string {
	if v == nil || v.UserID == "" {
		return "Guest"
	}
	if v.PreviewAs != "" {
		return v.PreviewAs + " (GM preview)"
	}
	if v.IsGM {
		return v.UserID + " (GM)"
	}
	return v.UserID
}

templ Shell(data PageData, viewer *auth.Viewer, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title } — { data.CampaignName }</title>
			<style>
				:root { color-scheme: light dark; --ink: #1a1a1a; --paper: #fff; --accent: #1d4ed8; --line: #888; }
				* { box-sizing: border-box; }
				body { font-family: system-ui, sans-serif; color: var(--ink); background: var(--paper); margin: 0; line-height: 1.5; }
				.skip { position: absolute; left: -999px; }
				.skip:focus { left: 0.5rem; top: 0.5rem; background: #fff; padding: 0.5rem; z-index: 10; }
				.topnav { display: flex; gap: 1rem; align-items: center; padding: 0.5rem 1rem; border-bottom: 2px solid var(--line); }
				.topnav .primary { display: flex; gap: 0.25rem; }
				.topnav a { padding: 0.6rem 0.8rem; min-height: 44px; display: inline-flex; align-items: center; }
				.slot[data-slot="header-right"] { margin-left: auto; }
				.layout { display: block; max-width: 60rem; margin: 0 auto; padding: 0 1rem; }
				.drawer { border: 1px solid var(--line); margin: 1rem 0; }
				.drawer summary { cursor: pointer; padding: 0.6rem; min-height: 44px; }
				.banner { border: 2px solid var(--line); padding: 0.6rem 1rem; margin: 0.5rem 1rem; }
				.banner.preview-banner, .badge.preview { border-color: #b45309; }
				.banner.quarantine { border-style: dashed; }
				.badge { display: inline-block; border: 2px solid currentColor; border-radius: 0.4rem; padding: 0.1rem 0.5rem; font-size: 0.85rem; font-weight: 600; }
				.badge.open::before { content: "○ "; }
				.badge.secret::before { content: "▪ "; }
				.redacted { border: 1px dashed currentColor; padding: 0 0.3rem; }
				.notice { border-left: 4px solid var(--line); padding: 0.5rem 0.8rem; margin: 0.8rem 0; }
				.block-tag { font-weight: 700; }
				.btn, button.btn { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; padding: 0.5rem 1rem; border: 2px solid var(--accent); background: #fff; color: var(--accent); border-radius: 0.4rem; text-decoration: none; cursor: pointer; }
				.btn.primary { background: var(--accent); color: #fff; }
				.btn.secondary { border-color: var(--line); color: var(--ink); }
				a:focus-visible, button:focus-visible, summary:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
				.sse-state { font-size: 0.85rem; }
				.colophon { border-top: 2px solid var(--line); margin-top: 2rem; padding: 0.8rem 1rem; }
				.user-menu { display: flex; align-items: center; gap: 0.5rem; }
				.user-menu .btn { padding: 0.4rem 0.8rem; }
				.login-form { max-width: 24rem; margin: 0 auto; padding: 1.5rem; border: 1px solid var(--line); border-radius: 0.5rem; }
				.login-form h1 { margin-top: 0; }
				.login-form .form-group { margin-bottom: 1rem; }
				.login-form label { display: block; margin-bottom: 0.3rem; font-weight: 500; }
				.login-form input[type="text"], .login-form input[type="password"] { width: 100%; padding: 0.5rem; border: 1px solid var(--line); border-radius: 0.3rem; min-height: 44px; font-size: 1rem; }
				.login-form .btn { width: 100%; justify-content: center; margin-top: 0.5rem; }
				.login-form .error { color: #b91c1c; border: 1px solid #b91c1c; background: #fef2f2; padding: 0.75rem; border-radius: 0.3rem; margin-bottom: 1rem; font-size: 0.9rem; }
				.login-form .hint { font-size: 0.85rem; color: var(--line); margin-top: 1rem; }
				.login-form .hint a { color: var(--accent); }
				@media (prefers-reduced-motion: reduce) {
					* { transition: none !important; animation: none !important; }
				}
			</style>
		</head>
		<body>
			<a class="skip" href="#main">Skip to page content</a>
			<div class="shell">
				<header class="topnav">
					<span class="brand">{ data.CampaignName }</span>
					<nav class="primary" aria-label="Primary">
						<a href={ "/p/" + data.LandingPage + data.AsParam }>Read</a>
						<a href={ "/search" + data.AsParam }>Search</a>
						<a href={ "/graph" + data.AsParam }>Graph</a>
					</nav>
					<div class="slot" data-slot="header-right">
						if viewer != nil && viewer.UserID != "" {
							<div class="user-menu">
								if viewer.IsGM {
									<span class="badge" style="border-color: #b45309; color: #b45309;">GM</span>
								}
								<span>{ viewer.UserID }</span>
								<a class="btn secondary" href="/settings">Settings</a>
								<form method="post" action="/logout" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<button class="btn secondary" type="submit">Log out</button>
								</form>
							</div>
						} else {
							<div class="user-menu">
								<a class="btn" href="/login">Log in</a>
								<span class="hint" style="margin: 0; padding-left: 0.5rem;">Invite-only: GM shares a claim link</span>
							</div>
						}
						if data.PreviewAs != "" {
							<span class="badge preview">GM preview as { data.PreviewAs } · bannered + logged</span>
						}
						for _, s := range data.Slots {
							if s.SlotName == "header-right" {
								<div data-plugin-slot="header-right" data-component={ s.Component } data-plugin={ s.PluginID }></div>
							}
						}
					</div>
				</header>
				if data.PreviewAs != "" {
					<p class="banner preview-banner" role="status">GM preview as { data.PreviewAs } — you see exactly what they see. This view is logged.</p>
				}
				<div class="layout">
					<main class="sheet-col" id="main" tabindex="-1">
						@content
					</main>
					<details class="drawer">
						<summary>On this page & links</summary>
						<div class="slot" data-slot="sidebar-left">
							<b>Vault navigation</b>
							<ul class="nav">
								for _, n := range data.Nav {
									<li>
										if n.Active {
											<span aria-current="page">{ n.Title }</span>
										} else {
											<a href={ "/p/" + n.Path + data.AsParam }>{ n.Title }</a>
										}
									</li>
								}
							</ul>
							for _, s := range data.Slots {
								if s.SlotName == "sidebar-left" {
									<div data-plugin-slot="sidebar-left" data-component={ s.Component } data-plugin={ s.PluginID }></div>
								}
							}
						</div>
						<div class="slot" data-slot="sidebar-right">
							<b>Backlinks</b>
							if len(data.Backlinks) == 0 {
								<p>No backlinks.</p>
							} else {
								<ul class="backlinks">
									for _, b := range data.Backlinks {
										<li><a href={ "/p/" + b.Path + data.AsParam }>{ b.Title }</a></li>
									}
								</ul>
							}
							for _, s := range data.Slots {
								if s.SlotName == "sidebar-right" {
									<div data-plugin-slot="sidebar-right" data-component={ s.Component } data-plugin={ s.PluginID }></div>
								}
							}
						</div>
					</details>
				</div>
				<footer class="colophon">
					<div class="slot" data-slot="footer">{ data.CampaignName } · read path (Lane F1) · secrets filtered server-side</div>
					for _, s := range data.Slots {
						if s.SlotName == "footer" {
							<div data-plugin-slot="footer" data-component={ s.Component } data-plugin={ s.PluginID }></div>
						}
					}
				</footer>
			</div>
			<script>
				// Read-path SSE hello (Lane F1, Phase 2): per-viewer filtered
				// secret-flip events. No secret content ever rides the stream
				// unfiltered — the server re-filters per subscriber.
				(function () {
					var article = document.querySelector("article.page-body");
					var state = document.querySelector("[data-sse-state]");
					if (!article) return;
					var path = article.getAttribute("data-page-path") || "";
					var as = new URLSearchParams(location.search).get("as") || "";
					var url = "/events?path=" + encodeURIComponent(path) + "&as=" + encodeURIComponent(as);
					try {
						var src = new EventSource(url);
						src.addEventListener("hello", function () {
							if (state) state.textContent = "Live updates: connected.";
						});
						src.addEventListener("secret-flip", function () {
							if (state) state.textContent = "Live updates: change received, reloading.";
							location.reload();
						});
						src.onerror = function () {
							if (state) state.textContent = "Live updates: disconnected.";
						};
					} catch (e) {
						if (state) state.textContent = "Live updates: unavailable.";
					}
				})();
			</script>
		</body>
	</html>
}

templ PageBody(data PageData) {
	<p class="crumbs">Vault / <b>{ data.Title }</b></p>
	<h1>
		{ data.Title }
		if data.Secret {
			<span class="badge secret">Secret · owner + GM</span>
		} else {
			<span class="badge open">Open · guest-readable</span>
		}
	</h1>
	if data.Quarantined {
		<div class="banner quarantine" role="alert">Frontmatter quarantined (GM only): { data.Quarantine }. Page fails closed as secret.</div>
	}
	<div class="slot" data-slot="page-actions">
		<div class="actions">
			<a class="btn" href={ "/search" + data.AsParam }>Search</a>
			if data.ViewerLabel != "guest" && data.Path != "" {
				<a class="btn" href={ "/edit/p/" + data.Path + data.AsParam }>Edit</a>
			}
			<span class="sse-state" data-sse-state aria-live="polite">Live updates: connecting…</span>
		</div>
	</div>
	if len(data.TOC) > 0 {
		<nav class="toc" aria-label="Table of contents">
			<ul>
				for _, e := range data.TOC {
					<li><a href={ "#" + e.Anchor }>{ e.Title }</a></li>
				}
			</ul>
		</nav>
	}
	<article class="page-body" data-page-path={ data.Path }>
		@templ.Raw(data.BodyHTML)
	</article>
}

templ SearchBody(query string, hits []SearchHit, asParam string) {
	<h1>Search</h1>
	<form method="get" action="/search" role="search">
		<label for="q">Search the vault</label>
		<input id="q" name="q" type="search" value={ query } minlength="1"/>
		<button class="btn primary" type="submit">Search</button>
	</form>
	if query != "" {
		if len(hits) == 0 {
			<p role="status">No visible results for “{ query }”.</p>
		} else {
			<ul class="results">
				for _, h := range hits {
					<li>
						<a href={ "/p/" + strings.TrimSuffix(strings.TrimSuffix(h.Path, ".md"), ".markdown") + asParam }>{ h.Title }</a>
						if h.Secret {
							<span class="badge secret">Secret</span>
						}
						<p class="snippet">{ h.Snippet }</p>
					</li>
				}
			</ul>
		}
	}
}

templ NotFound(data PageData) {
	<h1>Not found</h1>
	<p role="status">No page at this address. Secret pages return this same page to unauthorized viewers.</p>
	<p><a href={ "/p/" + data.LandingPage + data.AsParam }>Back to start</a></p>
}

templ Placeholder(heading string, text string) {
	<h1>{ heading }</h1>
	<p role="status">{ text }</p>
}

// RawBody renders arbitrary HTML content (for dynamic pages like password reset result).
templ RawBody(htmlContent string) {
	@templ.Raw(htmlContent)
}

// CampaignSettings mirrors the campaign settings fields needed by the dashboard template.
type CampaignSettings struct {
	Name            string
	Created         string
	Base            string
	BaseVersion     string
	Overlay         string
	OverlayVersion  string
	EnabledFeatures []string
	EnabledPlugins  []string
	LandingPage     string
}

// CampaignDashboardData holds campaign settings for the dashboard template.
type CampaignDashboardData struct {
	Campaign *CampaignSettings
	Users    []*auth.User
	CSRFToken string
}

templ DashboardBody(data CampaignDashboardData) {
	<h1>GM Dashboard</h1>

	<section aria-labelledby="campaign-settings">
		<h2 id="campaign-settings">Campaign Settings</h2>
		<form method="post" action="/dashboard" class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>

			<fieldset>
				<legend>Basic Settings</legend>
				<div class="form-group">
					<label for="ds-name">Campaign Name</label>
					<input id="ds-name" name="name" type="text" value={ data.Campaign.Name } size="40" required>
				</div>
				<div class="form-group">
					<label for="ds-landing">Landing Page (vault-relative path, no extension)</label>
					<input id="ds-landing" name="landing-page" type="text" value={ data.Campaign.LandingPage } size="40" placeholder="welcome">
				</div>
			</fieldset>

			<fieldset>
				<legend>Ruleset Layers</legend>
				<div class="form-group">
					<label for="ds-base">Base Ruleset</label>
					<input id="ds-base" name="base" type="text" value={ data.Campaign.Base } size="30" placeholder="dnd">
					<label for="ds-base-version">Base Version (display only)</label>
					<input id="ds-base-version" name="base-version" type="text" value={ data.Campaign.BaseVersion } size="20" placeholder="5.2">
				</div>
				<div class="form-group">
					<label for="ds-overlay">Overlay Ruleset</label>
					<input id="ds-overlay" name="overlay" type="text" value={ data.Campaign.Overlay } size="30" placeholder="srd-5e-2014">
					<label for="ds-overlay-version">Overlay Version (display only)</label>
					<input id="ds-overlay-version" name="overlay-version" type="text" value={ data.Campaign.OverlayVersion } size="20" placeholder="2024">
				</div>
			</fieldset>

			<fieldset>
				<legend>Enabled Features (one per line)</legend>
				<div class="form-group">
					<textarea id="ds-features" name="features" rows="4" cols="50">{ strings.Join(data.Campaign.EnabledFeatures, "\n") }</textarea>
					<p class="hint">Feature IDs from installed ruleset packs. Unknown IDs will be rejected.</p>
				</div>
			</fieldset>

			<fieldset>
				<legend>Enabled Plugins (one per line)</legend>
				<div class="form-group">
					<textarea id="ds-plugins" name="plugins" rows="4" cols="50">{ strings.Join(data.Campaign.EnabledPlugins, "\n") }</textarea>
					<p class="hint">Plugin IDs from installed plugins. Unknown IDs will stay disabled.</p>
				</div>
			</fieldset>

			<div class="actions">
				<button class="btn primary" type="submit">Save Campaign Settings</button>
			</div>
		</form>
	</section>

	<section aria-labelledby="vault-export">
		<h2 id="vault-export">Vault Export</h2>
		<p>
			<a class="btn primary" href="/dashboard/vault.zip">Download vault zip (.zip)</a>
		</p>
		<p class="hint">GM-only and logged. Ships every vault file regardless of frontmatter owner (the GM owns the files); data artifacts (*.db, .sessionkey) and symlinks are never included.</p>
	</section>

	<section aria-labelledby="user-management">
		<h2 id="user-management">User Management</h2>
		<table class="user-table">
			<thead>
				<tr>
					<th>Username</th>
					<th>Role</th>
					<th>Created</th>
					<th>Last Login</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, u := range data.Users {
					<tr>
						<td>{ u.Username }</td>
						<td>
							if u.IsGM {
								<span class="badge" style="border-color: #b45309; color: #b45309;">GM</span>
							} else {
								<span class="badge open">Player</span>
							}
						</td>
						<td>{ formatTime(u.CreatedAt) }</td>
						<td>{ formatLastLogin(u.LastLogin) }</td>
						<td>
							if u.LockedUntil > time.Now().Unix() {
								<span class="badge" style="border-color: #b91c1c; color: #b91c1c;">Locked</span>
							} else if u.FailedLogins > 0 {
								<span class="badge" style="border-color: #b45309; color: #b45309;">{ u.FailedLogins } failed</span>
							} else {
								<span class="badge open">Active</span>
							}
						</td>
						<td class="user-actions">
							<form method="post" action="/dashboard/user/reset-password" style="display: inline;">
								<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
								<input type="hidden" name="username" value={ u.Username }>
								<button class="btn secondary" type="submit">Reset Password</button>
							</form>
							<form method="post" action="/dashboard/user/revoke-sessions" style="display: inline;">
								<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
								<input type="hidden" name="username" value={ u.Username }>
								<button class="btn secondary" type="submit">Revoke Sessions</button>
							</form>
							if !u.IsGM {
								<form method="post" action="/dashboard/user/make-gm" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<input type="hidden" name="username" value={ u.Username }>
									<button class="btn secondary" type="submit">Make GM</button>
								</form>
							} else if len(data.Users) > 1 {
								<form method="post" action="/dashboard/user/remove-gm" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<input type="hidden" name="username" value={ u.Username }>
									<button class="btn secondary" type="submit">Remove GM</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>

		<h3>Create New User</h3>
		<form method="post" action="/dashboard/user/create" class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
			<div class="form-group">
				<label for="new-username">Username</label>
				<input id="new-username" name="username" type="text" size="30" required pattern="[A-Za-z0-9._-]{1,64}">
			</div>
			<div class="form-group">
				<label for="new-password">Password (min 8 chars)</label>
				<input id="new-password" name="password" type="password" size="30" minlength="8" required>
			</div>
			<div class="form-group">
				<label>
					<input type="checkbox" name="is_gm" value="1"> Grant GM privileges
				</label>
			</div>
			<div class="actions">
				<button class="btn primary" type="submit">Create User</button>
			</div>
		</form>
	</section>
}

// formatTime formats a Unix timestamp as a readable date.
func formatTime(ts int64) string {
	if ts == 0 { return "Never" }
	return time.Unix(ts, 0).UTC().Format("2006-01-02 15:04 UTC")
}

// formatLastLogin formats last_login timestamp.
func formatLastLogin(ts int64) string {
	if ts == 0 { return "Never" }
	return time.Unix(ts, 0).UTC().Format("2006-01-02 15:04 UTC")
}