package templates

import (
	"net/url"
	"strconv"
	"strings"
	"time"
	"github.com/semiplane/yonder/internal/auth"
	"github.com/semiplane/yonder/internal/markdown"
)

// PageData is the server-filtered view model for a page render. BodyHTML,
// TOC, Links, and Nav have already passed secrets.Filter per-viewer;
// templates must never re-introduce hidden content (no client-side hiding,
// no raw page fields).
type PageData struct {
	Title         string
	Path          string
	BodyHTML      string
	TOC           []markdown.TOCEntry
	Backlinks     []Backlink
	Nav           []NavEntry
	Secret        bool
	Owner         string
	Quarantined   bool
	Quarantine    string
	ViewerLabel   string
	PreviewAs     string
	AsParam       string
	// NoDemoEcho suppresses the client-side ?as= echo in the shell SSE
	// bootstrap script. Sessions-only deployments (DemoAuth=false) set it
	// so the retired tier is not echoed even inertly; the reconnect and
	// secret-flip behavior is unchanged. The zero value (false) preserves
	// the shipped echo, so renders that predate the threading stay
	// byte-identical under DemoAuth=true.
	NoDemoEcho    bool
	Slots         []SlotMark
	CSRFToken     string // double-submit CSRF token for state-changing forms
	CampaignName  string // campaign name from campaign.yaml
	LandingPage   string // landing page from campaign.yaml (default "welcome")
	// ShowNewSubpage gates the "+ New subpage" button: set only for pages
	// under characters/<pc>/ when the viewer may write in that subtree
	// (same authorizeWrite gate as the write path). Never rendered for
	// guests or readers without a write grant.
	ShowNewSubpage bool
	// NewSubpageParent is the vault folder the new-page form opens under
	// (characters/<pc>), meaningful only when ShowNewSubpage is true.
	NewSubpageParent string
	// Sheet is the embedded sheet-header card for character pages
	// (derived values only, re-read from vault truth + secrets.Filtered;
	// nil when the page has no sheet or the viewer may not see it).
	Sheet *SheetCard
	// Subpages lists the visible children of characters/<pc>/ (secret
	// titles dropped server-side for unauthorized viewers, never redacted).
	Subpages []SubpageEntry
	// T1 theme selection: rendered as <html data-theme data-scheme> plus the
	// theme stylesheet <link>. Empty Theme = unthemed (core tokens only) and
	// renders no attribute and no link, byte-identical to a pre-T1 page.
	Theme  string
	Scheme string
	// PluginCSS / PluginJS are the concatenated stylesheets and scripts of
	// the enabled plugins (web.PluginAssets seam; the plugin registry
	// injected by serve). Empty renders nothing. CSS lands inside <style> in
	// the head — unescaped, since these are first-party plugin bytes, never
	// vault content.
	PluginCSS string
	PluginJS  string
}

// SheetStat is one derived ability row on the embedded sheet card.
type SheetStat struct {
	Name  string
	Value int64
}

// SheetCard is the embedded sheet-header card on a character page. Every
// field is a derived display value — never raw frontmatter.
type SheetCard struct {
	Title       string
	Class       string
	Ancestry    string
	Background  string
	Level       int64
	XP          int64
	HP          int64
	HPMax       int64
	HitDice     int64
	HitDiceMax  int64
	HitDie      int64
	Stats       []SheetStat
}

// SubpageEntry is one visible child page of a character tree.
type SubpageEntry struct {
	Path   string
	Title  string
	Secret bool
}

// GraphNode / GraphEdge are the HTML graph view model: already
// secret-filtered server-side (invisible pages and their edges are absent,
// never redacted).
type GraphNode struct {
	ID     string
	Title  string
	Secret bool
}

type GraphEdge struct {
	From string
	To   string
}

type Backlink struct {
	Path  string
	Title string
}

type NavEntry struct {
	Path   string
	Title  string
	Secret bool
	Active bool
}

type SearchHit struct {
	Path    string
	Title   string
	Snippet string
	Secret  bool
}

// SlotMark is one enabled plugin slot mount point for the shell. Marks come
// from the enabled-aware provider (plugins.Registry.SlotsFor via web
// SlotProvider) — never the raw registry — so a disabled plugin leaves no
// UI trace, not even a mount point. Components render client-side from the
// plugin fragment contract (Lane K display); the shell only mounts.
type SlotMark struct {
	SlotName  string // frozen slot name (header-right, sidebar-left, ...)
	ID        string // component id within the slot
	Component string // plugin component name (mount key)
	PluginID  string // owning plugin (CSS namespace)
	// HTML is the plugin's rendered fragment for this mount: server-rendered
	// from already-secret-filtered input (T1-D), escaped by the plugin, and
	// emitted raw here. Empty = the plugin rendered nothing (disabled,
	// unrecognized, or failed) and the mount stays empty, as before T1-D.
	HTML string
}

// htmlOpenTag / htmlCloseTag render the document element pair. Built in Go
// on purpose: templ.Attributes renders in Go map order, which is random per
// request — non-deterministic HTML breaks byte-stable output (and any
// golden/diff test) — so the T1 theme attributes are joined here instead.
// Unthemed returns the plain pre-T1 tags, byte-identical. The pair is
// emitted raw so templ stays balanced (a templ-level <html> element cannot
// take conditionally-present attributes).
func (d PageData) htmlOpenTag() string {
	if d.Theme == "" {
		return `<html lang="en">`
	}
	scheme := d.Scheme
	if scheme == "" {
		scheme = "light"
	}
	return `<html lang="en" data-theme="` + d.Theme + `" data-scheme="` + scheme + `">`
}

func (d PageData) htmlCloseTag() string { return "</html>" }

// pluginStyleBlock / pluginScriptBlock wrap the delivered plugin assets.
// Built in Go because templ passes <style>/<script> element content through
// literally — an @templ.Raw placed inside those elements renders as text —
// so the wrapping happens outside and only the bytes are emitted raw.
// Empty input returns "" (nothing rendered, nothing paid).
func (d PageData) pluginStyleBlock() string {
	if d.PluginCSS == "" {
		return ""
	}
	return "<style>\n" + d.PluginCSS + "\n</style>"
}

func (d PageData) pluginScriptBlock() string {
	if d.PluginJS == "" {
		return ""
	}
	return "<script>\n" + d.PluginJS + "\n</script>"
}

// slotFilled reports whether an enabled plugin mounts in this slot. Core
// renders its own fallback content (nav list, backlinks, action buttons) only
// when no plugin takes the slot, so an enabled plugin replaces the fallback
// instead of duplicating it (the demo vault rendered Search/Edit twice, and
// the vault tree twice, before this).
func slotFilled(marks []SlotMark, slot string) bool {
	for _, m := range marks {
		if m.SlotName == slot {
			return true
		}
	}
	return false
}

func viewerName(v *auth.Viewer) string {
	if v == nil || v.UserID == "" {
		return "Guest"
	}
	if v.PreviewAs != "" {
		return v.PreviewAs + " (GM preview)"
	}
	if v.IsGM {
		return v.UserID + " (GM)"
	}
	return v.UserID
}

// navLoggedIn reports whether the primary nav shows the player links
// (Table/Characters). Guests see Read only.
func navLoggedIn(v *auth.Viewer) bool {
	return v != nil && v.UserID != ""
}

// navIsGM reports whether the primary nav shows the Dashboard link. A GM
// previewing as a player sees exactly what they see: no Dashboard link.
func navIsGM(v *auth.Viewer) bool {
	return v != nil && v.UserID != "" && v.IsGM && v.PreviewAs == ""
}

// withAsParam threads the demo identity (?as=) onto a URL that already
// carries a query string.
func withAsParam(base, asParam string) string {
	if asParam == "" {
		return base
	}
	sep := "?"
	if strings.Contains(base, "?") {
		sep = "&"
	}
	return base + sep + strings.TrimPrefix(asParam, "?")
}

templ Shell(data PageData, viewer *auth.Viewer, content templ.Component) {
	<!DOCTYPE html>
	@templ.Raw(data.htmlOpenTag())
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title } — { data.CampaignName }</title>
			<link rel="stylesheet" href="/static/core/app.css"/>
			<link rel="stylesheet" href="/static/core/statblock.css"/>
			<link rel="stylesheet" href="/static/print.css" media="print"/>
			if data.Theme != "" {
				<link rel="stylesheet" href={ "/static/themes/" + data.Theme + ".css" }/>
			}
			@templ.Raw(data.pluginStyleBlock())
			@templ.Raw(data.pluginScriptBlock())
		</head>
		<body>
			<a class="skip" href="#main">Skip to page content</a>
			<div class="shell">
				<header class="topnav">
					<div class="slot" data-slot="header-left">
						for _, s := range data.Slots {
							if s.SlotName == "header-left" {
								<div data-plugin-slot="header-left" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
							}
						}
					</div>
					<span class="brand">{ data.CampaignName }</span>
					<nav class="primary" aria-label="Primary">
						<a href={ "/p/" + data.LandingPage + data.AsParam }>Read</a>
						if navLoggedIn(viewer) {
							<a href={ "/vtt/" + data.AsParam }>Table</a>
							<a href={ "/me" + data.AsParam }>Characters</a>
						}
						if navIsGM(viewer) {
							<a href={ "/dashboard" + data.AsParam }>Dashboard</a>
						}
					</nav>
					<div class="slot" data-slot="header-center">
						for _, s := range data.Slots {
							if s.SlotName == "header-center" {
								<div data-plugin-slot="header-center" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
							}
						}
					</div>
					<div class="slot" data-slot="header-right">
						if viewer != nil && viewer.UserID != "" {
							<div class="user-menu">
								if viewer.IsGM {
									<span class="badge gm">GM</span>
								}
								<span>{ viewer.UserID }</span>
								<form method="post" action="/logout" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<button class="btn secondary" type="submit">Log out</button>
								</form>
							</div>
						} else {
							<div class="user-menu">
								<a class="btn" href="/login">Log in</a>
								<span class="hint" style="margin: 0; padding-left: 0.5rem;">Invite-only: GM shares a claim link</span>
							</div>
						}
						if data.PreviewAs != "" {
							<span class="badge preview">GM preview as { data.PreviewAs } · bannered + logged</span>
						}
						for _, s := range data.Slots {
							if s.SlotName == "header-right" {
								<div data-plugin-slot="header-right" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
							}
						}
					</div>
				</header>
				if data.PreviewAs != "" {
					<p class="banner preview-banner" role="status">GM preview as { data.PreviewAs } — you see exactly what they see. This view is logged.</p>
				}
				<div class="layout">
					<main class="sheet-col" id="main" tabindex="-1">
						@content
					</main>
					<section class="rail rail-left" aria-label="Vault navigation">
						<details class="drawer" open>
							<summary>Vault navigation</summary>
							<div class="slot" data-slot="sidebar-left">
								if !slotFilled(data.Slots, "sidebar-left") {
									<ul class="nav">
										for _, n := range data.Nav {
											<li>
												if n.Active {
													<span aria-current="page">{ n.Title }</span>
												} else {
													<a href={ "/p/" + n.Path + data.AsParam }>{ n.Title }</a>
												}
											</li>
										}
									</ul>
								}
								for _, s := range data.Slots {
									if s.SlotName == "sidebar-left" {
										<div data-plugin-slot="sidebar-left" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
									}
								}
							</div>
						</details>
					</section>
					<section class="rail rail-right" aria-label="On this page &amp; links">
						<details class="drawer" open>
							<summary>On this page &amp; links</summary>
							<div class="slot" data-slot="sidebar-right">
								if !slotFilled(data.Slots, "sidebar-right") {
									if len(data.Backlinks) == 0 {
										<p>No backlinks.</p>
									} else {
										<ul class="backlinks">
											for _, b := range data.Backlinks {
												<li><a href={ "/p/" + b.Path + data.AsParam }>{ b.Title }</a></li>
											}
										</ul>
									}
								}
								for _, s := range data.Slots {
									if s.SlotName == "sidebar-right" {
										<div data-plugin-slot="sidebar-right" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
									}
								}
							</div>
						</details>
					</section>
				</div>
				<footer class="colophon">
					<div class="slot" data-slot="footer">{ data.CampaignName } · read path (Lane F1) · secrets filtered server-side</div>
					for _, s := range data.Slots {
						if s.SlotName == "footer" {
							<div data-plugin-slot="footer" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
						}
					}
				</footer>
			</div>
			if !data.NoDemoEcho {
			<script>
				// Read-path SSE hello (Lane F1, Phase 2): per-viewer filtered
				// secret-flip events. No secret content ever rides the stream
				// unfiltered — the server re-filters per subscriber.
				(function () {
					var article = document.querySelector("article.page-body");
					var state = document.querySelector("[data-sse-state]");
					if (!article) return;
					var path = article.getAttribute("data-page-path") || "";
					var as = new URLSearchParams(location.search).get("as") || "";
					var url = "/events?path=" + encodeURIComponent(path) + "&as=" + encodeURIComponent(as);
					try {
						var src = new EventSource(url);
						src.addEventListener("hello", function () {
							if (state) state.textContent = "Live updates: connected.";
						});
						src.addEventListener("secret-flip", function () {
							if (state) state.textContent = "Live updates: change received, reloading.";
							location.reload();
						});
						src.onerror = function () {
							if (state) state.textContent = "Live updates: disconnected.";
						};
					} catch (e) {
						if (state) state.textContent = "Live updates: unavailable.";
					}
				})();
			</script>
			} else {
			<script>
				// Read-path SSE hello (Lane F1, Phase 2): per-viewer filtered
				// secret-flip events. No secret content ever rides the stream
				// unfiltered — the server re-filters per subscriber.
				(function () {
					var article = document.querySelector("article.page-body");
					var state = document.querySelector("[data-sse-state]");
					if (!article) return;
					var path = article.getAttribute("data-page-path") || "";
					var url = "/events?path=" + encodeURIComponent(path);
					try {
						var src = new EventSource(url);
						src.addEventListener("hello", function () {
							if (state) state.textContent = "Live updates: connected.";
						});
						src.addEventListener("secret-flip", function () {
							if (state) state.textContent = "Live updates: change received, reloading.";
							location.reload();
						});
						src.onerror = function () {
							if (state) state.textContent = "Live updates: disconnected.";
						};
					} catch (e) {
						if (state) state.textContent = "Live updates: unavailable.";
					}
				})();
			</script>
			}
		</body>
		@templ.Raw(data.htmlCloseTag())
}

templ PageBody(data PageData) {
	<p class="crumbs">Vault / <b>{ data.Title }</b></p>
	<h1>
		{ data.Title }
		if data.Secret {
			<span class="badge secret">Secret · owner + GM</span>
		} else {
			<span class="badge open">Open · guest-readable</span>
		}
	</h1>
	if data.Quarantined {
		<div class="banner quarantine" role="alert">Frontmatter quarantined (GM only): { data.Quarantine }. Page fails closed as secret.</div>
	}
	<div class="slot" data-slot="page-actions">
		if !slotFilled(data.Slots, "page-actions") {
			<div class="actions">
				<a class="btn" href={ "/search" + data.AsParam }>Search</a>
				if data.ViewerLabel != "guest" && data.Path != "" {
					<a class="btn" href={ "/edit/p/" + data.Path + data.AsParam }>Edit</a>
				}
				if data.ShowNewSubpage {
					<a class="btn" href={ withAsParam("/p/new?parent="+url.QueryEscape(data.NewSubpageParent), data.AsParam) }>+ New subpage</a>
				}
			</div>
		}
		<span class="sse-state" data-sse-state aria-live="polite">Live updates: connecting…</span>
		for _, s := range data.Slots {
			if s.SlotName == "page-actions" {
				<div data-plugin-slot="page-actions" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
			}
		}
	</div>
	if len(data.TOC) > 0 {
		<nav class="toc" aria-label="Table of contents">
			<ul>
				for _, e := range data.TOC {
					<li><a href={ "#" + e.Anchor }>{ e.Title }</a></li>
				}
			</ul>
		</nav>
	}
	<article class="page-body" data-page-path={ data.Path }>
		@templ.Raw(data.BodyHTML)
	</article>
	if data.Sheet != nil {
		<div class="sheet-card">
			<div class="slot" data-slot="sheet-header">
				<div class="sheet-head"><h2>{ data.Sheet.Title } — { data.Sheet.Class }, level { strconv.FormatInt(data.Sheet.Level, 10) }</h2></div>
				<p>{ data.Sheet.Ancestry } · { data.Sheet.Background } · HP { strconv.FormatInt(data.Sheet.HP, 10) }/{ strconv.FormatInt(data.Sheet.HPMax, 10) } · Hit dice { strconv.FormatInt(data.Sheet.HitDice, 10) }/{ strconv.FormatInt(data.Sheet.HitDiceMax, 10) } (d{ strconv.FormatInt(data.Sheet.HitDie, 10) }) · XP { strconv.FormatInt(data.Sheet.XP, 10) }</p>
				<table>
					<tbody>
						for _, st := range data.Sheet.Stats {
							<tr><th scope="row">{ st.Name }</th><td>{ strconv.FormatInt(st.Value, 10) }</td></tr>
						}
					</tbody>
				</table>
				for _, s := range data.Slots {
					if s.SlotName == "sheet-header" {
						<div data-plugin-slot="sheet-header" data-component={ s.Component } data-plugin={ s.PluginID }>@templ.Raw(s.HTML)</div>
					}
				}
			</div>
		</div>
	}
	if len(data.Subpages) > 0 {
		<section aria-labelledby="subpages">
			<h2 id="subpages">Subpages</h2>
			<ul>
				for _, s := range data.Subpages {
					<li>
						<a href={ "/p/" + s.Path + data.AsParam }>{ s.Title }</a>
						if s.Secret {
							<span class="badge secret">Secret</span>
						}
					</li>
				}
			</ul>
		</section>
	}
}

templ SearchBody(query string, hits []SearchHit, asParam string) {
	<h1>Search</h1>
	<form method="get" action="/search" role="search">
		<label for="q">Search the vault</label>
		<input id="q" name="q" type="search" value={ query } minlength="1"/>
		<button class="btn primary" type="submit">Search</button>
	</form>
	if query != "" {
		if len(hits) == 0 {
			<p role="status">No visible results for “{ query }”.</p>
		} else {
			<ul class="results">
				for _, h := range hits {
					<li>
						<a href={ "/p/" + strings.TrimSuffix(strings.TrimSuffix(h.Path, ".md"), ".markdown") + asParam }>{ h.Title }</a>
						if h.Secret {
							<span class="badge secret">Secret</span>
						}
						<p class="snippet">{ h.Snippet }</p>
					</li>
				}
			</ul>
		}
	}
}

templ GraphBody(nodes []GraphNode, edges []GraphEdge, asParam string) {
	<h1>Graph</h1>
	<p role="status">{ strconv.Itoa(len(nodes)) } pages, { strconv.Itoa(len(edges)) } links visible to you.</p>
	<h2>Pages</h2>
	if len(nodes) == 0 {
		<p>No visible pages.</p>
	} else {
		<ul class="graph-nodes">
			for _, n := range nodes {
				<li>
					<a href={ "/p/" + strings.TrimSuffix(strings.TrimSuffix(n.ID, ".md"), ".markdown") + asParam }>{ n.Title }</a>
					if n.Secret {
						<span class="badge secret">Secret</span>
					}
				</li>
			}
		</ul>
	}
	<h2>Links</h2>
	if len(edges) == 0 {
		<p>No visible links.</p>
	} else {
		<ul class="graph-edges">
			for _, e := range edges {
				<li><span>{ e.From }</span> → <span>{ e.To }</span></li>
			}
		</ul>
	}
}

templ NotFound(data PageData) {
	<h1>Not found</h1>
	<p role="status">No page at this address. Secret pages return this same page to unauthorized viewers.</p>
	<p><a href={ "/p/" + data.LandingPage + data.AsParam }>Back to start</a></p>
}

templ Placeholder(heading string, text string) {
	<h1>{ heading }</h1>
	<p role="status">{ text }</p>
}

// RawBody renders arbitrary HTML content (for dynamic pages like password reset result).
templ RawBody(htmlContent string) {
	@templ.Raw(htmlContent)
}

// CampaignSettings mirrors the campaign settings fields needed by the dashboard template.
type CampaignSettings struct {
	Name            string
	Created         string
	Base            string
	BaseVersion     string
	Overlay         string
	OverlayVersion  string
	EnabledFeatures []string
	EnabledPlugins  []string
	LandingPage     string
}

// CampaignDashboardData holds campaign settings for the dashboard template.
type CampaignDashboardData struct {
	Campaign *CampaignSettings
	Users    []*auth.User
	CSRFToken string
	// AsParam threads the demo identity (?as=) across dashboard links/forms.
	AsParam string
	// Dice is the recent dice log (newest last in render order), already
	// secret-filtered server-side per viewer: Total is nil for blind rolls
	// the viewer may not see. Templates-local mirror of plugins.DiceLogEntry
	// (sharing the type would cycle: plugins imports web, web imports
	// templates, so templates cannot import plugins).
	Dice []DiceLogRow
	// Encounter is the encounter builder + live token list (GM-only).
	Encounter EncounterData
}

// DiceLogRow is one rendered dice-log row (server-filtered).
type DiceLogRow struct {
	RollID   string
	Actor    string
	Notation string
	Total    *int64 // nil = blind/redacted for this viewer
	Blind    bool
}

// EncounterCreature is one spawnable compendium creature (HP resolved
// server-side at render).
type EncounterCreature struct {
	ID   string
	Name string
	HP   int
}

// EncounterToken is one live token on the selected map (GM-only viewers).
type EncounterToken struct {
	ID     string
	Name   string
	X      int
	Y      int
	HP     int
	MaxHP  int
	Hidden bool
}

// EncounterData is the dashboard encounter section (all server-resolved,
// GM-only).
type EncounterData struct {
	Roster []EncounterCreature
	Maps   []string
	Map    string // selected map
	Tokens []EncounterToken
}

templ DashboardBody(data CampaignDashboardData) {
	<h1>GM Dashboard</h1>

	<section aria-labelledby="campaign-settings">
		<h2 id="campaign-settings">Campaign Settings</h2>
		<form method="post" action="/dashboard" class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>

			<fieldset>
				<legend>Basic Settings</legend>
				<div class="form-group">
					<label for="ds-name">Campaign Name</label>
					<input id="ds-name" name="name" type="text" value={ data.Campaign.Name } size="40" required>
				</div>
				<div class="form-group">
					<label for="ds-landing">Landing Page (vault-relative path, no extension)</label>
					<input id="ds-landing" name="landing-page" type="text" value={ data.Campaign.LandingPage } size="40" placeholder="welcome">
				</div>
			</fieldset>

			<fieldset>
				<legend>Ruleset Layers</legend>
				<div class="form-group">
					<label for="ds-base">Base Ruleset</label>
					<input id="ds-base" name="base" type="text" value={ data.Campaign.Base } size="30" placeholder="dnd">
					<label for="ds-base-version">Base Version (display only)</label>
					<input id="ds-base-version" name="base-version" type="text" value={ data.Campaign.BaseVersion } size="20" placeholder="5.2">
				</div>
				<div class="form-group">
					<label for="ds-overlay">Overlay Ruleset</label>
					<input id="ds-overlay" name="overlay" type="text" value={ data.Campaign.Overlay } size="30" placeholder="srd-5e-2014">
					<label for="ds-overlay-version">Overlay Version (display only)</label>
					<input id="ds-overlay-version" name="overlay-version" type="text" value={ data.Campaign.OverlayVersion } size="20" placeholder="2024">
				</div>
			</fieldset>

			<fieldset>
				<legend>Enabled Features (one per line)</legend>
				<div class="form-group">
					<textarea id="ds-features" name="features" rows="4" cols="50">{ strings.Join(data.Campaign.EnabledFeatures, "\n") }</textarea>
					<p class="hint">Feature IDs from installed ruleset packs. Unknown IDs will be rejected.</p>
				</div>
			</fieldset>

			<fieldset>
				<legend>Enabled Plugins (one per line)</legend>
				<div class="form-group">
					<textarea id="ds-plugins" name="plugins" rows="4" cols="50">{ strings.Join(data.Campaign.EnabledPlugins, "\n") }</textarea>
					<p class="hint">Plugin IDs from installed plugins. Unknown IDs will stay disabled.</p>
				</div>
			</fieldset>

			<div class="actions">
				<button class="btn primary" type="submit">Save Campaign Settings</button>
			</div>
		</form>
	</section>

	<section aria-labelledby="vault-export">
		<h2 id="vault-export">Vault Export</h2>
		<p>
			<a class="btn primary" href="/dashboard/vault.zip">Download vault zip (.zip)</a>
		</p>
		<p class="hint">GM-only and logged. Ships every vault file regardless of frontmatter owner (the GM owns the files); data artifacts (*.db, .sessionkey) and symlinks are never included.</p>
	</section>

	<section aria-labelledby="user-management">
		<h2 id="user-management">User Management</h2>
		<table class="user-table">
			<thead>
				<tr>
					<th>Username</th>
					<th>Role</th>
					<th>Created</th>
					<th>Last Login</th>
					<th>Status</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, u := range data.Users {
					<tr>
						<td>{ u.Username }</td>
						<td>
							if u.IsGM {
								<span class="badge gm">GM</span>
							} else {
								<span class="badge open">Player</span>
							}
						</td>
						<td>{ formatTime(u.CreatedAt) }</td>
						<td>{ formatLastLogin(u.LastLogin) }</td>
						<td>
							if u.LockedUntil > time.Now().Unix() {
								<span class="badge locked">Locked</span>
							} else if u.FailedLogins > 0 {
								<span class="badge failed">{ u.FailedLogins } failed</span>
							} else {
								<span class="badge open">Active</span>
							}
						</td>
						<td class="user-actions">
							<form method="post" action="/dashboard/user/reset-password" style="display: inline;">
								<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
								<input type="hidden" name="username" value={ u.Username }>
								<button class="btn secondary" type="submit">Reset Password</button>
							</form>
							<form method="post" action="/dashboard/user/revoke-sessions" style="display: inline;">
								<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
								<input type="hidden" name="username" value={ u.Username }>
								<button class="btn secondary" type="submit">Revoke Sessions</button>
							</form>
							if !u.IsGM {
								<form method="post" action="/dashboard/user/make-gm" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<input type="hidden" name="username" value={ u.Username }>
									<button class="btn secondary" type="submit">Make GM</button>
								</form>
							} else if len(data.Users) > 1 {
								<form method="post" action="/dashboard/user/remove-gm" style="display: inline;">
									<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
									<input type="hidden" name="username" value={ u.Username }>
									<button class="btn secondary" type="submit">Remove GM</button>
								</form>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>

		<h3>Create New User</h3>
		<form method="post" action="/dashboard/user/create" class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
			<div class="form-group">
				<label for="new-username">Username</label>
				<input id="new-username" name="username" type="text" size="30" required pattern="[A-Za-z0-9._-]{1,64}">
			</div>
			<div class="form-group">
				<label for="new-password">Password (min 8 chars)</label>
				<input id="new-password" name="password" type="password" size="30" minlength="8" required>
			</div>
			<div class="form-group">
				<label>
					<input type="checkbox" name="is_gm" value="1"> Grant GM privileges
				</label>
			</div>
			<div class="actions">
				<button class="btn primary" type="submit">Create User</button>
			</div>
		</form>
	</section>

	<section aria-labelledby="dice-tray">
		<h2 id="dice-tray">Dice</h2>
		<form method="post" action={ "/api/dice/roll" + data.AsParam } class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
			<div class="form-group">
				<label for="dice-notation">Notation (max 100 dice / 1000 faces)</label>
				<input id="dice-notation" name="notation" type="text" size="20" required placeholder="2d6+3">
			</div>
			<div class="form-group">
				<label>
					<input type="checkbox" name="blind" value="on"> Blind (GM only)
				</label>
			</div>
			<div class="actions">
				<button class="btn primary" type="submit">Roll</button>
			</div>
		</form>
		<h3>Recent rolls</h3>
		<ol aria-live="polite">
			for _, r := range data.Dice {
				<li data-roll={ r.RollID }>
					<span>{ r.Actor }</span>
					<span>{ r.Notation }</span>
					if r.Total != nil {
						<span>{ diceTotalText(*r.Total) }</span>
					} else {
						<span>▓▓ blind roll (GM only)</span>
					}
					<a href={ "/api/dice/replay?roll_id=" + r.RollID }>replay</a>
				</li>
			}
		</ol>
	</section>

	<section aria-labelledby="encounters">
		<h2 id="encounters">Encounters</h2>
		<h3>Build & spawn</h3>
		<form method="post" action={ "/encounter" + data.AsParam } class="dashboard-form">
			<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
			<input type="hidden" name="action" value="spawn">
			<div class="form-group">
				<label for="enc-map">Map</label>
				<input id="enc-map" name="map" type="text" size="20" required value={ data.Encounter.Map } pattern="[A-Za-z0-9_-]{1,64}">
			</div>
			for _, c := range data.Encounter.Roster {
				<div class="form-group">
					<label for={ "enc-count-" + c.ID }>{ c.Name } (HP { diceTotalText(int64(c.HP)) })</label>
					<input id={ "enc-count-" + c.ID } name={ c.ID } type="number" min="0" max="20" value="0">
				</div>
			}
			<div class="actions">
				<button class="btn primary" type="submit">Spawn encounter</button>
			</div>
		</form>
		<h3>Tokens on { data.Encounter.Map }</h3>
		<p class="hint">
			for _, m := range data.Encounter.Maps {
				<a href={ dashMapURL(m, data.AsParam) }>{ m }</a>
				<span> </span>
			}
		</p>
		if len(data.Encounter.Tokens) == 0 {
			<p class="hint">No tokens on this map yet.</p>
		} else {
			<ul>
				for _, t := range data.Encounter.Tokens {
					<li data-token={ t.ID }>
						<span>{ t.Name }</span>
						<span>({ diceTotalText(int64(t.X)) },{ diceTotalText(int64(t.Y)) })</span>
						<span>{ diceTotalText(int64(t.HP)) }/{ diceTotalText(int64(t.MaxHP)) } HP</span>
						if t.Hidden {
							<span class="tag">hidden</span>
						}
						<form method="post" action={ "/encounter" + data.AsParam } style="display: inline;">
							<input type="hidden" name="csrf_token" value={ data.CSRFToken }>
							<input type="hidden" name="action" value="hp">
							<input type="hidden" name="map" value={ data.Encounter.Map }>
							<input type="hidden" name="token" value={ t.ID }>
							<label>Adjust HP <input name="delta" type="number" min="-999" max="999" value="-1" size="5"></label>
							<button class="btn secondary" type="submit">Apply</button>
						</form>
					</li>
				}
			</ul>
		}
	</section>
}

// diceTotalText renders a dice total for the dashboard log.
func diceTotalText(n int64) string {
	return strconv.FormatInt(n, 10)
}

// dashMapURL threads the demo identity across dashboard map links (map ids
// are charset-bound server-side, escaped here for URL safety).
func dashMapURL(m, asParam string) string {
	u := "/dashboard?map=" + url.QueryEscape(m)
	if strings.HasPrefix(asParam, "?") {
		u += "&" + strings.TrimPrefix(asParam, "?")
	}
	return u
}

// formatTime formats a Unix timestamp as a readable date.

// formatTime formats a Unix timestamp as a readable date.
func formatTime(ts int64) string {
	if ts == 0 { return "Never" }
	return time.Unix(ts, 0).UTC().Format("2006-01-02 15:04 UTC")
}

// formatLastLogin formats last_login timestamp.
func formatLastLogin(ts int64) string {
	if ts == 0 { return "Never" }
	return time.Unix(ts, 0).UTC().Format("2006-01-02 15:04 UTC")
}
