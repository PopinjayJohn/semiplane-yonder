package templates

import (
	"github.com/semiplane/yonder/internal/auth"
	"github.com/semiplane/yonder/internal/markdown"
)

// PageData is the server-filtered view model for a page render. BodyHTML,
// TOC, Links, and Nav have already passed secrets.Filter per-viewer;
// templates must never re-introduce hidden content (no client-side hiding,
// no raw page fields).
type PageData struct {
	Title       string
	Path        string
	BodyHTML    string
	TOC         []markdown.TOCEntry
	Backlinks   []Backlink
	Nav         []NavEntry
	Secret      bool
	Owner       string
	Quarantined bool
	Quarantine  string
	ViewerLabel string
	PreviewAs   string
	AsParam     string
}

type Backlink struct {
	Path  string
	Title string
}

type NavEntry struct {
	Path   string
	Title  string
	Secret bool
	Active bool
}

type SearchHit struct {
	Path    string
	Title   string
	Snippet string
	Secret  bool
}

func viewerName(v *auth.Viewer) string {
	if v == nil || v.UserID == "" {
		return "Guest"
	}
	if v.PreviewAs != "" {
		return v.PreviewAs + " (GM preview)"
	}
	if v.IsGM {
		return v.UserID + " (GM)"
	}
	return v.UserID
}

templ Shell(data PageData, viewer *auth.Viewer, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ data.Title } — Yonder</title>
			<style>
				:root { color-scheme: light dark; --ink: #1a1a1a; --paper: #fff; --accent: #1d4ed8; --line: #888; }
				* { box-sizing: border-box; }
				body { font-family: system-ui, sans-serif; color: var(--ink); background: var(--paper); margin: 0; line-height: 1.5; }
				.skip { position: absolute; left: -999px; }
				.skip:focus { left: 0.5rem; top: 0.5rem; background: #fff; padding: 0.5rem; z-index: 10; }
				.topnav { display: flex; gap: 1rem; align-items: center; padding: 0.5rem 1rem; border-bottom: 2px solid var(--line); }
				.topnav .primary { display: flex; gap: 0.25rem; }
				.topnav a { padding: 0.6rem 0.8rem; min-height: 44px; display: inline-flex; align-items: center; }
				.slot[data-slot="header-right"] { margin-left: auto; }
				.layout { display: block; max-width: 60rem; margin: 0 auto; padding: 0 1rem; }
				.drawer { border: 1px solid var(--line); margin: 1rem 0; }
				.drawer summary { cursor: pointer; padding: 0.6rem; min-height: 44px; }
				.banner { border: 2px solid var(--line); padding: 0.6rem 1rem; margin: 0.5rem 1rem; }
				.banner.preview-banner, .badge.preview { border-color: #b45309; }
				.banner.quarantine { border-style: dashed; }
				.badge { display: inline-block; border: 2px solid currentColor; border-radius: 0.4rem; padding: 0.1rem 0.5rem; font-size: 0.85rem; font-weight: 600; }
				.badge.open::before { content: "○ "; }
				.badge.secret::before { content: "▪ "; }
				.redacted { border: 1px dashed currentColor; padding: 0 0.3rem; }
				.notice { border-left: 4px solid var(--line); padding: 0.5rem 0.8rem; margin: 0.8rem 0; }
				.block-tag { font-weight: 700; }
				.btn, button.btn { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; padding: 0.5rem 1rem; border: 2px solid var(--accent); background: #fff; color: var(--accent); border-radius: 0.4rem; text-decoration: none; cursor: pointer; }
				.btn.primary { background: var(--accent); color: #fff; }
				a:focus-visible, button:focus-visible, summary:focus-visible, input:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
				.sse-state { font-size: 0.85rem; }
				.colophon { border-top: 2px solid var(--line); margin-top: 2rem; padding: 0.8rem 1rem; }
				@media (prefers-reduced-motion: reduce) {
					* { transition: none !important; animation: none !important; }
				}
			</style>
		</head>
		<body>
			<a class="skip" href="#main">Skip to page content</a>
			<div class="shell">
				<header class="topnav">
					<span class="brand">Yonder</span>
					<nav class="primary" aria-label="Primary">
						<a href="/p/welcome.md">Read</a>
						<a href="/search">Search</a>
						<a href="/graph">Graph</a>
					</nav>
					<div class="slot" data-slot="header-right">
						{ viewerName(viewer) }
						if data.PreviewAs != "" {
							<span class="badge preview">GM preview as { data.PreviewAs } · bannered + logged</span>
						}
					</div>
				</header>
				if data.PreviewAs != "" {
					<p class="banner preview-banner" role="status">GM preview as { data.PreviewAs } — you see exactly what they see. This view is logged.</p>
				}
				<div class="layout">
					<main class="sheet-col" id="main" tabindex="-1">
						@content
					</main>
					<details class="drawer">
						<summary>On this page &amp; links</summary>
						<div class="slot" data-slot="sidebar-left">
							<b>Vault navigation</b>
							<ul class="nav">
								for _, n := range data.Nav {
									<li>
										if n.Active {
											<span aria-current="page">{ n.Title }</span>
										} else {
											<a href={ "/p/" + n.Path + data.AsParam }>{ n.Title }</a>
										}
									</li>
								}
							</ul>
						</div>
						<div class="slot" data-slot="sidebar-right">
							<b>Backlinks</b>
							if len(data.Backlinks) == 0 {
								<p>No backlinks.</p>
							} else {
								<ul class="backlinks">
									for _, b := range data.Backlinks {
										<li><a href={ "/p/" + b.Path + data.AsParam }>{ b.Title }</a></li>
									}
								</ul>
							}
						</div>
					</details>
				</div>
				<footer class="colophon">
					<div class="slot" data-slot="footer">Yonder · read path (Lane F1) · secrets filtered server-side</div>
				</footer>
			</div>
			<script>
				// Read-path SSE hello (Lane F1, Phase 2): per-viewer filtered
				// secret-flip events. No secret content ever rides the stream
				// unfiltered — the server re-filters per subscriber.
				(function () {
					var article = document.querySelector("article.page-body");
					var state = document.querySelector("[data-sse-state]");
					if (!article) return;
					var path = article.getAttribute("data-page-path") || "";
					var as = new URLSearchParams(location.search).get("as") || "";
					var url = "/events?path=" + encodeURIComponent(path) + "&as=" + encodeURIComponent(as);
					try {
						var src = new EventSource(url);
						src.addEventListener("hello", function () {
							if (state) state.textContent = "Live updates: connected.";
						});
						src.addEventListener("secret-flip", function () {
							if (state) state.textContent = "Live updates: change received, reloading.";
							location.reload();
						});
						src.onerror = function () {
							if (state) state.textContent = "Live updates: disconnected.";
						};
					} catch (e) {
						if (state) state.textContent = "Live updates: unavailable.";
					}
				})();
			</script>
		</body>
	</html>
}

templ PageBody(data PageData) {
	<p class="crumbs">Vault / <b>{ data.Title }</b></p>
	<h1>
		{ data.Title }
		if data.Secret {
			<span class="badge secret">Secret · owner + GM</span>
		} else {
			<span class="badge open">Open · guest-readable</span>
		}
	</h1>
	if data.Quarantined {
		<div class="banner quarantine" role="alert">Frontmatter quarantined (GM only): { data.Quarantine }. Page fails closed as secret.</div>
	}
	<div class="slot" data-slot="page-actions">
		<div class="actions">
			<a class="btn" href={ "/search" + data.AsParam }>Search</a>
			<span class="sse-state" data-sse-state aria-live="polite">Live updates: connecting…</span>
		</div>
	</div>
	if len(data.TOC) > 0 {
		<nav class="toc" aria-label="Table of contents">
			<ul>
				for _, e := range data.TOC {
					<li><a href={ "#" + e.Anchor }>{ e.Title }</a></li>
				}
			</ul>
		</nav>
	}
	<article class="page-body" data-page-path={ data.Path }>
		@templ.Raw(data.BodyHTML)
	</article>
}

templ SearchBody(query string, hits []SearchHit, asParam string) {
	<h1>Search</h1>
	<form method="get" action="/search" role="search">
		<label for="q">Search the vault</label>
		<input id="q" name="q" type="search" value={ query } minlength="1"/>
		<button class="btn primary" type="submit">Search</button>
	</form>
	if query != "" {
		if len(hits) == 0 {
			<p role="status">No visible results for “{ query }”.</p>
		} else {
			<ul class="results">
				for _, h := range hits {
					<li>
						<a href={ "/p/" + h.Path + asParam }>{ h.Title }</a>
						if h.Secret {
							<span class="badge secret">Secret</span>
						}
						<p class="snippet">{ h.Snippet }</p>
					</li>
				}
			</ul>
		}
	}
}

templ NotFound() {
	<h1>Not found</h1>
	<p role="status">No page at this address. Secret pages return this same page to unauthorized viewers.</p>
	<p><a href="/p/welcome.md">Back to start</a></p>
}

templ Placeholder(heading string, text string) {
	<h1>{ heading }</h1>
	<p role="status">{ text }</p>
}
